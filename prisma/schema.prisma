generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum QuoteRequestStatus {
  DRAFT
  QUEUED
  RUNNING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  CANCELLED
}

enum CarrierExecutionStatus {
  PENDING
  QUEUED
  STARTING
  AUTHENTICATING
  FILLING_FORM
  SUBMITTING
  READING_RESULTS
  WAITING_HUMAN
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCELLED
}

enum CarrierCredentialStatus {
  ACTIVE
  DISABLED
  ROTATED
}

enum ExecutionArtifactType {
  SCREENSHOT
  TRACE
  HTML_SNAPSHOT
  DOM_SUMMARY
  RAW_RESPONSE
  LOG_EXCERPT
}

enum CoverageCode {
  MEDICAL_HOSPITAL
  COVID_MEDICAL
  DENTAL
  PHARMACEUTICAL
  BAGGAGE_LOSS
  BAGGAGE_DELAY
  FLIGHT_DELAY
  TRIP_CANCELLATION
  TRIP_INTERRUPTION
  MEDICAL_TRANSFER
  BODY_TRANSFER
  LEGAL_ASSISTANCE
  ACCIDENTAL_DEATH
  PERMANENT_DISABILITY
  OTHER
}

enum HumanInterventionType {
  CAPTCHA
  MFA
  SESSION_EXPIRED
  TERMS_CHANGED
  UNKNOWN_PAGE
  MANUAL_REVIEW
}

enum HumanInterventionStatus {
  PENDING
  RESOLVED
  EXPIRED
  CANCELLED
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String?
  providerId   String?
  role         UserRole       @default(OPERATOR)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  quoteRequests QuoteRequest[]
  auditLogs      AuditLog[]
  interventions  HumanIntervention[] @relation("ResolvedInterventions")
}

model QuoteRequest {
  id                 String             @id @default(uuid())
  userId             String
  originCountry      String
  destinationJson    Json
  departureDate      DateTime           @db.Date
  returnDate         DateTime           @db.Date
  tripPurpose        String
  status             QuoteRequestStatus @default(QUEUED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  travelers  Traveler[]
  executions CarrierExecution[]
  auditLogs  AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model Traveler {
  id             String   @id @default(uuid())
  quoteRequestId String
  birthDate      DateTime @db.Date
  createdAt      DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

model Carrier {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  enabled        Boolean  @default(true)
  adapterVersion String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  credentials CarrierCredential[]
  executions  CarrierExecution[]
  plans       TravelPlan[]
}

model CarrierCredential {
  id               String                  @id @default(uuid())
  carrierId        String
  organizationId   String?
  encryptedPayload String
  keyVersion       String
  status           CarrierCredentialStatus @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@index([carrierId])
}

model CarrierExecution {
  id                     String                 @id @default(uuid())
  quoteRequestId         String
  carrierId              String
  status                 CarrierExecutionStatus @default(QUEUED)
  attempt                Int                    @default(1)
  startedAt              DateTime?
  finishedAt             DateTime?
  errorCode              String?
  errorMessageSanitized  String?
  currentStep            String?
  externalQuoteReference String?
  adapterVersion         String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  quoteRequest  QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  carrier       Carrier             @relation(fields: [carrierId], references: [id])
  plans         TravelPlan[]
  artifacts     ExecutionArtifact[]
  interventions HumanIntervention[]

  @@index([quoteRequestId])
  @@index([carrierId])
  @@index([status])
}

model TravelPlan {
  id                     String    @id @default(uuid())
  carrierExecutionId     String
  carrierId              String
  externalPlanId         String?
  planName               String
  currency               String
  totalPrice             Decimal   @db.Decimal(12, 2)
  pricePerTraveler       Decimal?  @db.Decimal(12, 2)
  validUntil             DateTime?
  purchaseUrl            String?
  rawResultJsonEncrypted String?
  rawResultReference     String?
  collectedAt            DateTime

  carrierExecution CarrierExecution @relation(fields: [carrierExecutionId], references: [id], onDelete: Cascade)
  carrier          Carrier          @relation(fields: [carrierId], references: [id])
  coverages        Coverage[]

  @@index([carrierExecutionId])
  @@index([carrierId])
}

model Coverage {
  id           String       @id @default(uuid())
  travelPlanId String
  code         CoverageCode
  displayName  String
  amount       Decimal?     @db.Decimal(12, 2)
  currency     String?
  included     Boolean
  details      String?

  travelPlan TravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)

  @@index([travelPlanId])
}

model ExecutionArtifact {
  id                 String                @id @default(uuid())
  carrierExecutionId String
  type               ExecutionArtifactType
  storageKey         String
  mimeType           String
  sanitized          Boolean
  expiresAt          DateTime
  createdAt          DateTime              @default(now())

  carrierExecution CarrierExecution @relation(fields: [carrierExecutionId], references: [id], onDelete: Cascade)

  @@index([carrierExecutionId])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  quoteRequestId String?
  action         String
  entityType     String
  entityId       String
  metadataJson   Json
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id])

  @@index([userId])
  @@index([quoteRequestId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model HumanIntervention {
  id                 String                  @id @default(uuid())
  carrierExecutionId String
  type               HumanInterventionType
  status             HumanInterventionStatus @default(PENDING)
  instructions       String
  expiresAt          DateTime
  resolvedByUserId   String?
  resolvedAt         DateTime?
  createdAt          DateTime                @default(now())

  carrierExecution CarrierExecution @relation(fields: [carrierExecutionId], references: [id], onDelete: Cascade)
  resolvedByUser   User?            @relation("ResolvedInterventions", fields: [resolvedByUserId], references: [id])

  @@index([carrierExecutionId])
  @@index([status])
  @@index([expiresAt])
}
