NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_quotes
REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

JWT_SECRET=replace_me
ENCRYPTION_KEY=replace_me
ARTIFACT_STORAGE_PATH=./var/artifacts

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_LOCALE=pt-BR
PLAYWRIGHT_TIMEZONE=America/Sao_Paulo
PLAYWRIGHT_ALLOW_FILE_URLS=true
PLAYWRIGHT_ALLOWED_ORIGINS=
HUMAN_INTERVENTION_TIMEOUT_MS=600000

QUOTE_DATA_RETENTION_DAYS=90
ARTIFACT_RETENTION_DAYS=7
LOG_RETENTION_DAYS=30

CARRIER_A_ENABLED=true
CARRIER_A_MODE=mock
CARRIER_A_USERNAME=
CARRIER_A_PASSWORD=

CARRIER_B_ENABLED=true
CARRIER_B_MODE=mock
CARRIER_B_USERNAME=
CARRIER_B_PASSWORD=

CARRIER_C_ENABLED=true
CARRIER_C_MODE=mock
